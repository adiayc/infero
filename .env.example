# Copy to .env. Secrets and runtime knobs only.
# The .env file is gitignored — never commit real keys.

# Path to the YAML config.
INFERO_CONFIG_PATH=config.yaml

# Server bind.
INFERO_HOST=127.0.0.1
INFERO_PORT=8000
INFERO_LOG_LEVEL=info

# Optional static client->gateway auth key. Leave unset to disable auth.
# INFERO_API_KEY=changeme

# Where the CLI keeps the background server's log/record and chat history.
# Defaults to ~/.infero.
# INFERO_STATE_DIR=

# --- provider API keys -------------------------------------------------------
# Set only the ones you use. A backend whose key is unset is never built, so it
# never becomes a routing candidate and nothing fails. `infero keys` lists the
# state of each; `infero keys --check` verifies them against the provider.
#
# These names are the defaults for each `provider:` preset in config.yaml;
# override per backend with `api_key_env`.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# MOONSHOT_API_KEY=sk-...          # Kimi
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
